{
  "name": "@textmesh/api-client",
  "version": "1.0.0",
  "description": "TypeScript API client for TextMesh platform",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "rimraf": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.7.0"
  },
  "keywords": [
    "textmesh",
    "api",
    "client",
    "sdk",
    "social-media"
  ],
  "author": "TextMesh Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/textmesh/textmesh.git",
    "directory": "packages/api-client"
  }
}
