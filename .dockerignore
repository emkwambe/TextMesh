# =================================
# TEXTMESH DOCKER IGNORE
# =================================

# Dependencies
node_modules
**/node_modules

# Build outputs
dist
**/dist
*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# IDE and editor files
.idea
.vscode
*.swp
*.swo
*~

# Git
.git
.gitignore
.gitattributes

# Documentation
*.md
!README.md
docs

# Test files
**/*.test.ts
**/*.spec.ts
**/__tests__
coverage
.nyc_output

# Development files
.turbo
.eslintrc*
.prettierrc*
tsconfig.tsbuildinfo

# OS files
.DS_Store
Thumbs.db

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Mobile apps (not needed in Docker)
apps/ios
apps/android

# Kubernetes manifests (not needed in Docker build)
k8s

# CI/CD
.github
.gitlab-ci.yml
Jenkinsfile

# Docker files (avoid nested builds)
docker-compose*.yml
Dockerfile*

# Misc
*.tgz
*.tar.gz
*.zip
